APP_NAME="Opel Tools B2C"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.opeltools.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database (MySQL — production) ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opeltools_b2c
DB_USERNAME=root
DB_PASSWORD=

# ── Cache / Session ───────────────────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailerhost.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@opeltools.com"
MAIL_FROM_NAME="${APP_NAME}"
